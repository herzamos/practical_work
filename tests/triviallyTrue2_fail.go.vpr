method triviallyTrue2_bdedb392_F_unicity(a_V0: Int, a_V0_unicity: Int, b_V0: Int,
  b_V0_unicity: Int)
{
  
  // decl 
  {
    
    
    
    // inhale (a_V0 > 10)
    inhale a_V0 > 10
    
    // inhale (a_V0_unicity > 10)
    inhale a_V0_unicity > 10
    
    // inhale (a_V0 > 15) && (b_V0 < 10)
    inhale a_V0 > 15 && b_V0 < 10
    
    // inhale (a_V0_unicity > 15) && (b_V0_unicity < 10)
    inhale a_V0_unicity > 15 && b_V0_unicity < 10
    
    // inhale (a_V0 > 15) ==> (b_V0 < 10)
    inhale a_V0 > 15 ==> b_V0 < 10
    
    // inhale (a_V0_unicity > 15) ==> (b_V0_unicity < 10)
    inhale a_V0_unicity > 15 ==> b_V0_unicity < 10
    
    // inhale ((a_V0 > 15)?(b_V0 < 10):true || (b_V0 > 15))
    inhale (a_V0 > 15 ? b_V0 < 10 : true) || b_V0 > 15
    
    // inhale ((a_V0_unicity > 15)?(b_V0_unicity < 10):true || (b_V0_unicity > 15))
    inhale (a_V0_unicity > 15 ? b_V0_unicity < 10 : true) ||
      b_V0_unicity > 15
    
    // refute (a_V0 == a_V0_unicity)
    refute a_V0 == a_V0_unicity
    
    // refute (b_V0 == b_V0_unicity)
    refute b_V0 == b_V0_unicity
    label returnLabel
  }
}